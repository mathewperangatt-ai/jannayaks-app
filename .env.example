APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# Trusted proxies: "*" (default, trust all) or comma-separated IPs/CIDR ranges.
# Production should list Cloudflare + Railway ranges, e.g. (verify current lists):
# TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=jannayaks
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible). Used when MEDIA_PUBLIC_DISK=r2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# Applicant source materials: PRIVATE S3-compatible R2 bucket (durable storage).
# The bucket MUST stay private — files stream only via the staff download route.
# Set SOURCE_MATERIALS_DISK=source_materials in production; leave empty to use
# local private_uploads (ephemeral on Railway). Legacy rows keep their original disk.
SOURCE_MATERIALS_DISK=
R2_SOURCE_BUCKET=
R2_SOURCE_ENDPOINT=
R2_SOURCE_REGION=auto
# Optional dedicated R2 credentials for the source bucket; falls back to R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
R2_SOURCE_ACCESS_KEY_ID=
R2_SOURCE_SECRET_ACCESS_KEY=

# Profile media disk: "public" for local/tests, "r2" for production.
MEDIA_PUBLIC_DISK=public
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_MAX_EDGE_PX=1600
MEDIA_JPEG_QUALITY=82

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

JANNAYAKS_OTP_CHANNEL=log
# P7: no SMS provider. OTP is log/test-cache only.
# Set JANNAYAKS_OTP_LOGIN_ENABLED=false in production so OTP sign-in is hidden and
# disabled until a real SMS provider is integrated (avoids false "OTP sent" claims).
JANNAYAKS_OTP_LOGIN_ENABLED=true
JANNAYAKS_OTP_EXPOSE_TEST_CODE=false

# P8 billing / GST tax invoice supplier fields (leave blank until registration is confirmed — do not invent GSTIN)
JANNAYAKS_BILLING_LEGAL_NAME=
JANNAYAKS_BILLING_GSTIN=
JANNAYAKS_BILLING_ADDRESS=
JANNAYAKS_BILLING_STATE=
JANNAYAKS_BILLING_PLACE_OF_SUPPLY=
JANNAYAKS_BILLING_SUPPORT_EMAIL=
# Working refund assumption only — reconfirm before production
JANNAYAKS_REFUND_BEFORE_PUBLICATION_PERCENT=60

# P10 AI editorial (never commit real secrets)
JANNAYAKS_AI_PROVIDER=gpt
JANNAYAKS_AI_MALAYALAM_ENABLED=true
JANNAYAKS_OPENAI_MODEL=gpt-4.1-mini
JANNAYAKS_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
JANNAYAKS_OPENAI_TIMEOUT=60
OPENAI_API_KEY=

RESEND_API_KEY=
POSTMARK_API_KEY=
