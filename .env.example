APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# Trusted proxies (S2). Default (unset): Cloudflare published ranges + private
# platform ranges (RFC1918/CGNAT/loopback) — see app/Support/TrustedProxiesConfig.php.
# "*" trusts all claimants and must be set EXPLICITLY; a comma-separated list
# replaces the default entirely.
# TRUSTED_PROXIES=203.0.113.7,198.51.100.0/24
# APP_MAINTENANCE_STORE=database

# CSP (S2): enforced by default; set to false for Report-Only while debugging.
# JANNAYAKS_CSP_ENFORCE=false

# Payments testing mode (TEMPORARY, pre-gateway-launch). GLOBAL impact while
# true: the payment requirement is suspended for all applications (testers
# complete the whole workflow without paying, no fake settlements are
# recorded), payment initiation endpoints are refused, and AI photo
# enhancement follows testing mode unless JANNAYAKS_AI_ENHANCEMENT_ENABLED is
# set explicitly. Safe / production setting: false or unset. Must be
# false/unset in production — documentation and defaults are not a runtime
# production guard. Set false / remove to restore the normal payment-required
# workflow — no migration needed. See docs/temporary-test-safety-switches.md.
# JANNAYAKS_PAYMENTS_TESTING_MODE=false

# Temporary editorial test bypass (DISABLED by default). Applies only to the
# comma-separated profile reference allowlist — never to every application.
# Does not record a payment or mark an editorial draft approved, and does not
# allow an unapproved draft to be published. Confirm the reference identifies
# exactly one synthetic test profile before enabling. Set the flag false (or
# remove it) to restore the normal workflow; no database reset is required.
# JANNAYAKS_EDITORIAL_TEST_BYPASS_ENABLED=false
# JANNAYAKS_EDITORIAL_TEST_BYPASS_REFERENCES=

# Temporary publication test bypass (DISABLED by default). Separate from the
# editorial preview bypass. Applies only to the comma-separated profile
# reference allowlist, and only while that profile is not already public.
# Skips the publication payment check for that profile alone. Does not record
# a payment or settlement. Customer approval of the exact approved English
# version is still required; the exceptional admin path cannot use this.
# Confirm the reference is the single non-public test profile before enabling.
# Set the flag false to restore the payment gate. Unpublish the test profile
# after layout verification; disabling the flag does not hide an already
# public URL.
# JANNAYAKS_PUBLICATION_TEST_BYPASS_ENABLED=false
# JANNAYAKS_PUBLICATION_TEST_BYPASS_REFERENCES=

# AI profile-photo enhancement. Unset follows payments testing mode.
# An explicit true/false always wins. The default provider "fake" is a
# simulated re-encode, not genuine AI. Genuine enhancement requires
# JANNAYAKS_AI_IMAGE_PROVIDER=openai and OPENAI_API_KEY (same secret as editorial).
# Jobs use the photo-enhancement queue. With QUEUE_CONNECTION=database they
# are drained by the existing scheduler (schedule:work); there is no separate
# queue-worker service. DB_QUEUE_RETRY_AFTER must exceed the 240-second job
# timeout (default 300). A fake provider in production fails the run visibly
# and does not store a candidate.
# JANNAYAKS_AI_ENHANCEMENT_ENABLED=
# JANNAYAKS_AI_IMAGE_PROVIDER=fake

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=jannayaks
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Reservation window for the database queue, in seconds. Must exceed the
# longest queued job timeout. EnhanceProfilePhoto is the only queued job
# and times out at 240 seconds; 300 leaves a 60-second margin.
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible). Used when MEDIA_PUBLIC_DISK=r2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# Applicant source materials: PRIVATE S3-compatible R2 bucket (durable storage).
# The bucket MUST stay private — files stream only via the staff download route.
# Set SOURCE_MATERIALS_DISK=source_materials in production; leave empty to use
# local private_uploads (ephemeral on Railway). Legacy rows keep their original disk.
SOURCE_MATERIALS_DISK=
R2_SOURCE_BUCKET=
R2_SOURCE_ENDPOINT=
R2_SOURCE_REGION=auto
# Optional dedicated R2 credentials for the source bucket; falls back to R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY.
R2_SOURCE_ACCESS_KEY_ID=
R2_SOURCE_SECRET_ACCESS_KEY=

# Profile media disk: "public" for local/tests, "r2" for production.
MEDIA_PUBLIC_DISK=public
MEDIA_MAX_UPLOAD_KB=5120
MEDIA_MAX_EDGE_PX=1600
MEDIA_JPEG_QUALITY=82

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Indian mobile OTP login via the MSG91 OTP Widget.
# MSG91_AUTHKEY is the SERVER-ONLY secret (never expose to browser/tests/logs).
# MSG91_WIDGET_ID / MSG91_WIDGET_TOKEN are NON-secret client-side widget values
# from the MSG91 dashboard (SecureOTPWidgetYLBE).
MSG91_AUTHKEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_TIMEOUT_SECONDS=15
# Kill switch: set false to hide and disable OTP sign-in entirely.
JANNAYAKS_OTP_LOGIN_ENABLED=true

# Published Profile Integrity Monitor (report-only burn-in). Do not set enforce;
# enforcement does not exist yet and will arrive in a reviewed future wave.
JANNAYAKS_INTEGRITY_MODE=report
# Share of published primary photos deep-verified (streamed SHA-256) per run.
JANNAYAKS_INTEGRITY_DEEP_PERCENT=100
# Founder mailbox for integrity watchdog summary alerts (new incidents or mass mismatch).
JANNAYAKS_INTEGRITY_ALERT_RECIPIENT=mathew.perangatt@gmail.com

# P8 billing / GST tax invoice supplier fields (leave blank until registration is confirmed — do not invent GSTIN)
JANNAYAKS_BILLING_LEGAL_NAME=
JANNAYAKS_BILLING_GSTIN=
JANNAYAKS_BILLING_ADDRESS=
JANNAYAKS_BILLING_STATE=
JANNAYAKS_BILLING_PLACE_OF_SUPPLY=
JANNAYAKS_BILLING_SUPPORT_EMAIL=
# Working refund assumption only — reconfirm before production
JANNAYAKS_REFUND_BEFORE_PUBLICATION_PERCENT=60

# P10 AI editorial (never commit real secrets)
JANNAYAKS_AI_PROVIDER=gpt
JANNAYAKS_AI_MALAYALAM_ENABLED=true
JANNAYAKS_OPENAI_MODEL=gpt-4.1-mini
JANNAYAKS_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
JANNAYAKS_OPENAI_TIMEOUT=60
OPENAI_API_KEY=

RESEND_API_KEY=
POSTMARK_API_KEY=

# Weekly contact-numbers export recipient (TEMPORARY programme). Defaults to
# JANNAYAKS_PUBLIC_EMAIL when unset. The CSV is emailed to this address and
# the numbers are then removed from the applications table.
# JANNAYAKS_PHONE_EXPORT_RECIPIENT=owner@example.com
